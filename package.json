{
  "name": "seapower-ini",
  "displayName": "Sea Power INI",
  "description": "Autocomplete, error checking and Go to Definition for Sea Power INI files.",
  "version": "0.4.0",
  "publisher": "searats",
  "private": true,
  "repository": { "type": "git", "url": "https://github.com/SEARATS/sp-ini.git" },
  "engines": { "vscode": "^1.82.0" },
  "categories": ["Programming Languages"],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [{
      "id": "seapower-ini",
      "aliases": ["Sea Power INI"],
      "filenamePatterns": ["**/Sea Power_Data/StreamingAssets/**/*.ini", "**/workshop/content/1286220/**/*.ini"],
      "firstLine": "^\\s*#!(?:extend|prepend|alias|copy)\\b",
      "configuration": "./language.json"
    }, {
      "id": "wavefront-obj", "aliases": ["Wavefront OBJ"], "extensions": [".obj"]
    }],
    "grammars": [{ "language": "seapower-ini", "scopeName": "source.seapower-ini", "path": "./syntax.json" }],
    "customEditors": [{
      "viewType": "seapower-ini.obj",
      "displayName": "OBJ Preview",
      "selector": [{ "filenamePattern": "*.[oO][bB][jJ]" }],
      "priority": "default"
    }],
    "commands": [
      { "command": "seapower-ini.previewObj", "title": "Preview OBJ", "category": "Sea Power INI", "icon": "$(preview)" },
      { "command": "seapower-ini.refresh", "title": "Sea Power INI: Rebuild Content Index" },
      { "command": "seapower-ini.referencePreviews", "title": "Sea Power INI: Enable Read-Only Reference Previews in Workspace" }
    ],
    "menus": {
      "editor/title": [{ "command": "seapower-ini.previewObj", "when": "resourceExtname =~ /[.]obj$/i && activeCustomEditorId != seapower-ini.obj", "group": "navigation" }],
      "explorer/context": [{ "command": "seapower-ini.previewObj", "when": "resourceExtname =~ /[.]obj$/i && !explorerResourceIsFolder" }],
      "commandPalette": [{ "command": "seapower-ini.previewObj", "when": "resourceExtname =~ /[.]obj$/i" }]
    },
    "configuration": {
      "title": "Sea Power INI",
      "properties": {
        "seapowerIni.obj.openSourceBeside": {
          "type": "boolean", "default": true, "scope": "resource",
          "description": "Open the OBJ source beside its 3D preview."
        },
        "seapowerIni.gameDirectory": {
          "type": "string", "default": "", "scope": "machine",
          "description": "Sea Power installation folder containing Sea Power_Data. Leave empty to search Steam libraries."
        },
        "seapowerIni.localModDirectories": {
          "type": "array", "items": { "type": "string" }, "default": [], "scope": "machine",
          "description": "Additional absolute paths to local mod content folders."
        },
        "seapowerIni.workshopDirectories": {
          "type": "array", "items": { "type": "string" }, "default": [], "scope": "machine",
          "description": "Additional absolute paths to Steam Workshop content/1286220 folders."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test test/*.test.js",
    "package": "pnpm run build && vsce package --no-dependencies --skip-license"
  },
  "devDependencies": {
    "@vscode/vsce": "4.1.1",
    "three": "0.187.0",
    "esbuild": "0.28.2",
    "vscode-languageclient": "9.0.1",
    "vscode-languageserver": "9.0.1",
    "vscode-languageserver-textdocument": "1.0.12"
  }
}
