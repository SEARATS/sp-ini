{
  "name": "seapower-ini",
  "displayName": "Sea Power INI",
  "description": "Autocomplete, error checking and Go to Definition for Sea Power INI files.",
  "version": "0.9.26",
  "icon": "dist/icon.png",
  "publisher": "searats",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/SEARATS/sp-ini.git"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:wavefront-obj",
    "workspaceContains:**/_info.ini",
    "workspaceContains:**/*.[mM][aA][tT]"
  ],
  "contributes": {
    "languages": [
      {
        "id": "seapower-ini",
        "aliases": [
          "Sea Power INI"
        ],
        "filenamePatterns": [
          "**/Sea Power_Data/StreamingAssets/**/*.ini",
          "**/workshop/content/1286220/**/*.ini"
        ],
        "firstLine": "^\\s*#!(?:extend|prepend|alias|copy)\\b",
        "configuration": "./language.json"
      },
      {
        "id": "wavefront-obj",
        "aliases": [
          "Wavefront OBJ"
        ],
        "extensions": [
          ".obj"
        ]
      }
    ],
    "grammars": [
      {
        "language": "seapower-ini",
        "scopeName": "source.seapower-ini",
        "path": "./syntax.json"
      }
    ],
    "configurationDefaults": {
      "[wavefront-obj]": {
        "editor.showFoldingControls": "always"
      }
    },
    "customEditors": [
      {
        "viewType": "seapower-ini.obj",
        "displayName": "OBJ Preview",
        "selector": [
          {
            "filenamePattern": "*.[oO][bB][jJ]"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "seapower-ini.fbx",
        "displayName": "FBX Preview",
        "selector": [
          {
            "filenamePattern": "*.[fF][bB][xX]"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "seapower-ini.blend",
        "displayName": "Blender Scene Preview",
        "selector": [
          {
            "filenamePattern": "*.[bB][lL][eE][nN][dD]"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "seapower-ini.entity",
        "displayName": "Sea Power Entity Preview",
        "selector": [
          {
            "filenamePattern": "*.[iI][nN][iI]"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "seapower-ini.card",
        "displayName": "Sea Power Unit Card",
        "selector": [
          {
            "filenamePattern": "*.[iI][nN][iI]"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "seapower-ini.material",
        "displayName": "Sea Power Material Preview",
        "selector": [
          {
            "filenamePattern": "*.[mM][aA][tT]"
          },
          {
            "filenamePattern": "*.[iI][nN][iI]"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      { "command": "seapower-ini.exportIniData", "title": "Export INI Data…", "category": "Sea Power INI" },
      {
        "command": "seapower-ini.previewBlend",
        "title": "Preview Blender Scene",
        "category": "Sea Power INI"
      },
      {
        "command": "seapower-ini.exportBlendFBX",
        "title": "Export Blender Scene as FBX…",
        "category": "Sea Power INI"
      },
      {
        "command": "seapower-ini.exportBlendOBJ",
        "title": "Export Blender Scene as OBJ…",
        "category": "Sea Power INI"
      },
      {
        "command": "seapower-ini.previewObj",
        "title": "Preview OBJ",
        "category": "Sea Power INI",
        "icon": "$(preview)"
      },
      {
        "command": "seapower-ini.suppress",
        "title": "Suppress Diagnostic on This Line",
        "category": "Sea Power INI",
        "enablement": "editorLangId == seapower-ini && !editorReadonly"
      },
      {
        "command": "seapower-ini.toggleSection",
        "title": "Comment or Uncomment INI Section",
        "category": "Sea Power INI",
        "enablement": "editorLangId == seapower-ini && !editorReadonly"
      },
      {
        "command": "seapower-ini.refresh",
        "title": "Sea Power INI: Rebuild Content Index"
      },
      {
        "command": "seapower-ini.referencePreviews",
        "title": "Sea Power INI: Enable Read-Only Reference Previews in Workspace"
      },
      {
        "command": "seapower-ini.generate",
        "title": "Generate Submodels and Colliders…",
        "category": "Sea Power INI"
      },
      {
        "command": "seapower-ini.generateFromModel",
        "title": "Generate Submodels and Colliders…",
        "category": "Sea Power INI"
      },
      {
        "command": "seapower-ini.generateFromIni",
        "title": "Generate from Model Hierarchy…",
        "category": "Sea Power INI"
      },
      {
        "command": "seapower-ini.copyHierarchy",
        "title": "Copy Hierarchy as INI",
        "category": "Sea Power INI"
      },
      {
        "command": "seapower-ini.copyColliders",
        "title": "Copy Colliders as INI",
        "category": "Sea Power INI"
      },
      {
        "command": "seapower-ini.previewEntity",
        "title": "Preview Entity",
        "category": "Sea Power INI",
        "icon": "$(preview)"
      },
      {
        "command": "seapower-ini.analyze",
        "title": "Analyze INI Files…",
        "category": "Sea Power INI"
      },
      {
        "command": "seapower-ini.previewUnitCard",
        "title": "Preview Unit Card",
        "category": "Sea Power INI",
        "icon": "$(book)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "seapower-ini.suppress",
          "when": "editorLangId == seapower-ini && !editorReadonly",
          "group": "seapower@1"
        },
        {
          "command": "seapower-ini.toggleSection",
          "when": "editorLangId == seapower-ini && !editorReadonly",
          "group": "seapower@2"
        },
        {
          "command": "seapower-ini.generateFromIni",
          "when": "editorLangId == seapower-ini && !editorReadonly",
          "group": "seapower@3"
        }
      ],
      "editor/title": [
        {
          "command": "seapower-ini.previewObj",
          "when": "resourceExtname =~ /[.]obj$/i && activeCustomEditorId != seapower-ini.obj",
          "group": "navigation"
        },
        {
          "command": "seapower-ini.previewEntity",
          "when": "resourceExtname =~ /[.]ini$/i && activeCustomEditorId != seapower-ini.entity && (editorLangId == seapower-ini || resourcePath =~ /[\\\\\\/](vessels|aircraft|land_units|biologic|missions)[\\\\\\/]/i)",
          "group": "navigation"
        },
        {
          "command": "seapower-ini.previewUnitCard",
          "when": "resourceExtname =~ /[.]ini$/i && activeCustomEditorId != seapower-ini.card && (editorLangId == seapower-ini || resourcePath =~ /[\\\\\\/](vessels|aircraft|land_units|biologic|missions)[\\\\\\/]/i)",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        { "command": "seapower-ini.exportIniData", "when": "resourceScheme == file && resourceExtname =~ /[.](obj|fbx|blend)$/i", "group": "seapower@0" },
        {
          "command": "seapower-ini.previewBlend",
          "when": "!explorerResourceIsFolder && resourceScheme == file && resourceExtname =~ /[.]blend$/i",
          "group": "seapower@0"
        },
        {
          "command": "seapower-ini.exportBlendFBX",
          "when": "!explorerResourceIsFolder && resourceScheme == file && resourceExtname =~ /[.]blend$/i",
          "group": "seapower@1"
        },
        {
          "command": "seapower-ini.exportBlendOBJ",
          "when": "!explorerResourceIsFolder && resourceScheme == file && resourceExtname =~ /[.]blend$/i",
          "group": "seapower@2"
        },
        {
          "command": "seapower-ini.previewObj",
          "when": "resourceExtname =~ /[.]obj$/i && !explorerResourceIsFolder"
        },
        {
          "command": "seapower-ini.copyHierarchy",
          "when": "!explorerResourceIsFolder && resourceExtname =~ /[.]fbx$/i"
        },
        {
          "command": "seapower-ini.copyColliders",
          "when": "!explorerResourceIsFolder && resourceExtname =~ /[.]fbx$/i"
        },
        {
          "command": "seapower-ini.previewEntity",
          "when": "resourceExtname =~ /[.]ini$/i && !explorerResourceIsFolder"
        },
        {
          "command": "seapower-ini.previewUnitCard",
          "when": "resourceExtname =~ /[.]ini$/i && !explorerResourceIsFolder"
        }
      ],
      "commandPalette": [
        {
          "command": "seapower-ini.previewBlend",
          "when": "false"
        },
        {
          "command": "seapower-ini.exportBlendFBX",
          "when": "false"
        },
        {
          "command": "seapower-ini.exportBlendOBJ",
          "when": "false"
        },
        {
          "command": "seapower-ini.previewObj",
          "when": "resourceExtname =~ /[.]obj$/i"
        },
        {
          "command": "seapower-ini.generateFromModel",
          "when": "false"
        },
        {
          "command": "seapower-ini.generateFromIni",
          "when": "false"
        },
        {
          "command": "seapower-ini.copyHierarchy",
          "when": "false"
        },
        {
          "command": "seapower-ini.copyColliders",
          "when": "false"
        },
        {
          "command": "seapower-ini.previewEntity",
          "when": "resourceExtname =~ /[.]ini$/i"
        },
        {
          "command": "seapower-ini.previewUnitCard",
          "when": "resourceExtname =~ /[.]ini$/i"
        }
      ],
      "view/item/context": [
        { "command": "seapower-ini.exportIniData", "when": "view == seapower-ini.hierarchy", "group": "seapower@0" },
        {
          "command": "seapower-ini.generateFromModel",
          "when": "view == seapower-ini.hierarchy && viewItem == spIniParent"
        },
        {
          "command": "seapower-ini.copyHierarchy",
          "when": "view == seapower-ini.hierarchy && viewItem == spIniParent"
        },
        {
          "command": "seapower-ini.copyColliders",
          "when": "view == seapower-ini.hierarchy"
        }
      ],
      "editor/title/context": [
        { "command": "seapower-ini.exportIniData", "when": "resourceScheme == file && resourceExtname =~ /[.](obj|fbx|blend)$/i", "group": "seapower@0" },
        {
          "command": "seapower-ini.copyHierarchy",
          "when": "resourceExtname =~ /[.]fbx$/i"
        },
        {
          "command": "seapower-ini.copyColliders",
          "when": "resourceExtname =~ /[.]fbx$/i"
        }
      ],
      "webview/context": [
        { "command": "seapower-ini.exportIniData", "when": "spIniExportUri", "group": "seapower@0" },
        {
          "command": "seapower-ini.copyHierarchy",
          "when": "spIniFbxUri && !spIniLeaf"
        },
        {
          "command": "seapower-ini.copyColliders",
          "when": "spIniFbxUri"
        }
      ]
    },
    "configuration": {
      "title": "Sea Power INI",
      "properties": {
        "seapowerIni.missingTextureColor": {
          "type": "string",
          "enum": ["black", "magenta", "grey"],
          "default": "grey",
          "scope": "resource",
          "description": "Color used in 3D previews when a diffuse texture cannot be loaded. Changing the viewer dropdown saves this setting for the project."
        },
        "seapowerIni.meshFlags": {
          "type": "array",
          "scope": "resource",
          "markdownDescription": "Flag meshes in model and entity hierarchies. Rules match object and mesh names, ignoring case. Export INI Data uses the Collider, LOD and Damaged tags to suggest export roles. Edit rules in settings.json or use Tags on an individual mesh.",
          "items": {
            "type": "object",
            "required": ["label"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "minLength": 1, "description": "Flag name shown on hover." },
              "icon": { "type": "string", "pattern": "^[a-z0-9-]+$", "default": "tag", "description": "VS Code Codicon name, such as flame, layers or package." },
              "enabled": { "type": "boolean", "default": true, "description": "Display this flag when a name matches." },
              "substrings": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Literal text to find anywhere in a name." },
              "patterns": { "type": "array", "items": { "type": "string", "minLength": 1, "format": "regex" }, "description": "Regular expressions without surrounding slashes." }
            }
          },
          "default": [
            { "label": "Collider", "icon": "package", "substrings": ["coll"], "patterns": ["(?:^|_)col(?=$|[_.0-9])"] },
            { "label": "Primary mesh", "icon": "star-full" },
            { "label": "Primary damage mesh", "icon": "flame" },
            { "label": "Hull collider", "icon": "shield" },
            { "label": "Damaged", "icon": "flame", "patterns": ["_d(?:_?[0-9]+)?(?=$|_lod_?[0-9]+(?:$|_))"] },
            { "label": "LOD", "icon": "layers", "patterns": ["(?:^|_)lod_?[0-9]+(?:$|_)"] },
            { "label": "Glass", "icon": "eye", "patterns": ["(?:^|_)glass(?:$|_)"] },
            { "label": "Transparent", "icon": "color-mode", "patterns": ["(?:^|_)trans(?:$|_)"] },
            { "label": "Rotor / propeller disc", "icon": "circle-outline", "patterns": ["(?:^|_)disc(?:$|_)"] },
            { "label": "Parked", "icon": "debug-pause", "patterns": ["(?:^|_)parked(?:$|_)"] },
            { "label": "Folded", "icon": "fold", "patterns": ["(?:^|_)folded(?:$|_)"] },
            { "label": "Marking", "icon": "paintcan", "substrings": ["_decal", "_emblem", "_hullnumber", "_serial", "_modex"] },
            { "label": "Animated flag", "icon": "symbol-event", "substrings": ["_animatedflag"] },
            { "label": "Dummy", "icon": "symbol-field", "patterns": ["(?:^|_)dummy(?:$|_)"] },
            { "label": "Shadow", "icon": "circle-filled", "patterns": ["(?:^|_)shadow(?:$|_)"] }
          ]
        },
        "seapowerIni.blenderPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Full path to Blender for exporting .blend files. Leave empty to detect Blender automatically."
        },
        "seapowerIni.unitHints.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Show known Sea Power units beside numeric INI values as inlay hints."
        },
        "seapowerIni.obj.collapseObjectsOnOpen": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Collapse object blocks when opening OBJ source."
        },
        "seapowerIni.obj.openSourceBeside": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Open the OBJ source beside its 3D preview."
        },
        "seapowerIni.searchPaths.directory": {
          "type": "string",
          "default": "Assets",
          "scope": "window",
          "description": "Parent directory for the Resources and Data subdirectories. Relative paths start at each workspace folder. An absolute path uses one shared directory."
        },
        "seapowerIni.searchPaths.resourcesSubdirectory": {
          "type": "string",
          "default": "Resources",
          "scope": "window",
          "description": "Model, material and texture folder under the search directory."
        },
        "seapowerIni.searchPaths.dataSubdirectory": {
          "type": "string",
          "default": "StreamingAssets",
          "scope": "window",
          "description": "Sea Power content folder under the search directory."
        },
        "seapowerIni.search.order": {
          "type": "array",
          "order": 1,
          "scope": "window",
          "items": {
            "type": "string",
            "enum": [
              "projectRoot",
              "data",
              "resources",
              "mirror",
              "localMods",
              "installedMods",
              "userMods",
              "workshop",
              "game"
            ]
          },
          "uniqueItems": true,
          "default": [
            "projectRoot",
            "data",
            "resources",
            "mirror",
            "localMods",
            "installedMods",
            "userMods",
            "workshop",
            "game"
          ],
          "description": "Search enabled sources from top to bottom. Unlisted sources follow in their default order. Use the Search checkboxes to disable a source."
        },
        "seapowerIni.search.data": {
          "order": 3,
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Search the data subdirectory for game content, including original and local mods."
        },
        "seapowerIni.search.resources": {
          "order": 4,
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Resolve model, material and texture paths from the resources subdirectory."
        },
        "seapowerIni.search.projectRoot": {
          "order": 2,
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Search loose files starting at each open project root. The Resources and Data subdirectories have separate switches."
        },
        "seapowerIni.search.localMods": {
          "order": 6,
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Search folders listed in Local Mod Directories."
        },
        "seapowerIni.search.installedMods": {
          "order": 7,
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Search mod folders beside original in the game’s StreamingAssets directory."
        },
        "seapowerIni.search.userMods": {
          "order": 8,
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Search the Sea Power Mods folder in the Windows user profile."
        },
        "seapowerIni.search.workshop": {
          "order": 9,
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Search Steam Workshop items in detected libraries and Workshop Directories."
        },
        "seapowerIni.search.game": {
          "order": 10,
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Search the vanilla game INIs and packed Unity assets."
        },
        "seapowerIni.search.mirror": {
          "order": 5,
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Use the model and texture manifest in generated Unity workspaces."
        },
        "seapowerIni.gameDirectory": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Sea Power installation folder containing Sea Power_Data. Leave empty to search Steam libraries."
        },
        "seapowerIni.localModDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "description": "Additional absolute paths to local mod content folders."
        },
        "seapowerIni.workshopDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "description": "Additional absolute paths to Steam Workshop content/1286220 folders."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "seapower-ini.hierarchy",
          "name": "FBX hierarchy",
          "when": "activeCustomEditorId == seapower-ini.fbx || resourceExtname =~ /[.]fbx$/i"
        }
      ]
    }
  },
  "scripts": {
    "analyze": "tsx src/lint.ts",
    "icon": "tsx scripts/icon.ts",
    "scan:units": "tsx scripts/scan-unit-hints.ts",
    "build": "tsx scripts/build.ts",
    "test:fbx": "tsx scripts/build-fbx.ts && tsx scripts/check-fbx.ts",
    "test": "tsx scripts/build-fbx.ts && pnpm run typecheck && tsx --test test/*.test.ts",
    "package": "pnpm run build && vsce package --no-dependencies --skip-license",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/three": "0.183.1",
    "@types/vscode": "1.82.0",
    "@vscode/codicons": "0.0.36",
    "@vscode/vsce": "4.1.1",
    "diff": "8.0.2",
    "esbuild": "0.28.2",
    "jpeg-js": "0.4.4",
    "pngjs": "7.0.0",
    "three": "0.187.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vscode-languageclient": "9.0.1",
    "vscode-languageserver": "9.0.1",
    "vscode-languageserver-textdocument": "1.0.12",
    "yaml": "^2.9.1"
  }
}
